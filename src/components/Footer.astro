---
import { CONTACTO, MARCA, MENSAJE_WHATSAPP_DEFECTO, linkWhatsApp } from "../data/sitio";

const anio = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-white/8 pt-24">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="light-blob left-1/4 top-0 h-[26rem] w-[26rem] bg-neon-magenta/12"></div>
    <div class="light-blob right-1/4 top-10 h-[24rem] w-[24rem] bg-neon-cyan/12"></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- ── Llamado final ─────────────────────────────────────── -->
    <div class="text-center" data-reveal>
      <h2 class="font-display text-[clamp(2rem,7vw,4.5rem)] uppercase leading-[0.9]">
        <span class="text-white">¿Reservamos</span>
        <span class="text-gradient-neon">tu fecha?</span>
      </h2>

      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-white/55 sm:text-lg">
        Escríbeme por WhatsApp para confirmar disponibilidad, o completa el cuestionario musical y te
        respondo con una propuesta a medida.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={linkWhatsApp(MENSAJE_WHATSAPP_DEFECTO)}
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-neon-cyan to-neon-cyan-soft px-8 py-4 text-sm font-bold uppercase tracking-wider text-ink-950 shadow-[0_0_40px_-8px_var(--color-neon-cyan)] transition-all duration-300 hover:scale-[1.03] hover:shadow-[0_0_60px_-6px_var(--color-neon-cyan)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-ink-950"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12.04 2C6.6 2 2.17 6.43 2.17 11.87c0 1.74.46 3.44 1.32 4.94L2 22l5.34-1.4a9.83 9.83 0 0 0 4.7 1.2h.01c5.43 0 9.86-4.43 9.86-9.87A9.8 9.8 0 0 0 12.04 2Zm5.43 12.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.53.07-.8.38-.28.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.09 4.49.71.3 1.27.49 1.7.63.71.23 1.36.19 1.88.12.57-.09 1.76-.72 2-1.42.25-.7.25-1.29.18-1.42-.08-.13-.27-.2-.57-.35Z"
            ></path>
          </svg>
          {CONTACTO.whatsappVisible}
        </a>

        <a
          href="#reserva"
          class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/[0.03] px-8 py-4 text-sm font-bold uppercase tracking-wider text-white transition-all duration-300 hover:border-neon-magenta/60 hover:bg-neon-magenta/[0.08] hover:text-neon-magenta focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-magenta"
        >
          Completar cuestionario
        </a>
      </div>

      <!-- Redes -->
      <div class="mt-10 flex items-center justify-center gap-3">
        <a
          href={CONTACTO.instagramUrl}
          target="_blank"
          rel="noopener"
          class="group flex items-center gap-2.5 rounded-full border border-white/12 bg-white/[0.03] px-5 py-2.5 text-sm font-semibold text-white/65 transition-all duration-300 hover:border-neon-magenta/50 hover:text-neon-magenta focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-magenta"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16ZM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.12 1.39C1.35 2.68.93 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.39 2.12.66.67 1.33 1.09 2.12 1.39.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.3 1.46-.72 2.12-1.39.67-.66 1.09-1.33 1.39-2.12.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.3-.79-.72-1.46-1.39-2.12-.66-.67-1.33-1.09-2.12-1.39-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm7.85-10.41a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0Z"
            ></path>
          </svg>
          @{CONTACTO.instagram}
        </a>

        <a
          href={CONTACTO.facebookUrl}
          target="_blank"
          rel="noopener"
          class="group flex items-center gap-2.5 rounded-full border border-white/12 bg-white/[0.03] px-5 py-2.5 text-sm font-semibold text-white/65 transition-all duration-300 hover:border-neon-cyan/50 hover:text-neon-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07Z"
            ></path>
          </svg>
          @{CONTACTO.facebook}
        </a>
      </div>
    </div>

    <!-- ── Eslogan ───────────────────────────────────────────── -->
    <p
      class="mt-20 text-center font-display text-[clamp(0.95rem,2.4vw,1.5rem)] uppercase italic tracking-wide text-white/40"
      data-reveal
    >
      {MARCA.slogan}
    </p>

    <!-- ── Pie ───────────────────────────────────────────────── -->
    <div
      class="mt-14 flex flex-col items-center gap-4 border-t border-white/8 py-8 text-center sm:flex-row sm:justify-between sm:text-left"
    >
      <div>
        <p class="font-display text-lg uppercase tracking-wide text-white">{MARCA.nombre}</p>
        <p class="mt-1 text-xs uppercase tracking-[0.2em] text-white/35">{MARCA.rol}</p>
      </div>

      <p class="text-xs text-white/30">
        © {anio} {MARCA.nombreCorto}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
