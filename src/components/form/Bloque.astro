---
import type { Bloque } from "../../data/formulario";
import Campo from "./Campo.astro";
import { ACENTO_PUNTO, ACENTO_TEXTO } from "./estilos";

interface Props {
  bloque: Bloque;
  /** Acento heredado del paso si el bloque no define uno propio */
  acentoPaso: "cyan" | "magenta" | "yellow";
}

const { bloque, acentoPaso } = Astro.props;
const acento = bloque.acento ?? acentoPaso;
---

<section
  class="rounded-3xl border border-white/8 bg-ink-900/40 p-5 backdrop-blur-sm sm:p-7"
  data-bloque
  data-solo-eventos={bloque.soloEventos?.join("|")}
>
  {
    (bloque.titulo || bloque.autocompletar) && (
      <header class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
          {bloque.titulo && (
            <h3 class="flex items-center gap-3 text-lg font-bold tracking-tight text-white">
              <span
                class:list={["h-2 w-2 shrink-0 rounded-full", ACENTO_PUNTO[acento]]}
                aria-hidden="true"
              />
              {bloque.titulo}
            </h3>
          )}
          {bloque.nota && (
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/45">{bloque.nota}</p>
          )}
        </div>

        {bloque.autocompletar && (
          <button
            type="button"
            data-autocompletar={bloque.autocompletar.valor}
            class:list={[
              "shrink-0 rounded-full border border-white/15 bg-white/[0.04] px-4 py-2",
              "text-xs font-semibold uppercase tracking-wider",
              "transition-all duration-200 hover:border-white/35 hover:bg-white/10",
              "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan",
              ACENTO_TEXTO[acento],
            ]}
          >
            {bloque.autocompletar.etiqueta}
          </button>
        )}
      </header>
    )
  }

  <div class="grid gap-5 sm:grid-cols-2">
    {bloque.campos.map((campo) => <Campo campo={campo} acento={acento} />)}
  </div>
</section>
