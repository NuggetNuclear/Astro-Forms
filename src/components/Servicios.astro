---
import { EVENTOS } from "../data/sitio";

const ANILLO = {
  cyan: "hover:border-neon-cyan/50 hover:shadow-[0_0_50px_-16px_var(--color-neon-cyan)]",
  magenta: "hover:border-neon-magenta/50 hover:shadow-[0_0_50px_-16px_var(--color-neon-magenta)]",
  yellow: "hover:border-neon-yellow/50 hover:shadow-[0_0_50px_-16px_var(--color-neon-yellow)]",
} as const;

const TEXTO = {
  cyan: "text-neon-cyan",
  magenta: "text-neon-magenta",
  yellow: "text-neon-yellow",
} as const;

const FONDO = {
  cyan: "from-neon-cyan/20",
  magenta: "from-neon-magenta/20",
  yellow: "from-neon-yellow/20",
} as const;
---

<section id="servicios" class="relative scroll-mt-24 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <header class="mx-auto max-w-3xl text-center" data-reveal>
      <span
        class="inline-flex items-center gap-2 rounded-full border border-neon-magenta/30 bg-neon-magenta/[0.07] px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-neon-magenta"
      >
        <span class="h-1.5 w-1.5 animate-pulse-glow rounded-full bg-neon-magenta"></span>
        Eventos
      </span>

      <h2 class="mt-6 font-display text-4xl uppercase leading-[0.95] sm:text-6xl">
        Cada fiesta tiene <span class="text-gradient-neon">su propio ritmo</span>
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-white/55 sm:text-lg">
        No es lo mismo un matrimonio que una disco peque. Preparo el repertorio, la animación y la
        energía según el tipo de evento y las personas que van a estar ahí.
      </p>
    </header>

    <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        EVENTOS.map((evento, i) => (
          <article
            class:list={[
              "group relative overflow-hidden rounded-3xl border border-white/8 bg-ink-900/50 p-7",
              "transition-all duration-400 ease-out hover:-translate-y-1.5",
              ANILLO[evento.acento],
              evento.destacado && "sm:col-span-2 lg:col-span-1",
            ]}
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            {/* Resplandor que aparece al pasar el cursor */}
            <div
              class:list={[
                "pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full bg-gradient-to-br to-transparent opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-100",
                FONDO[evento.acento],
              ]}
              aria-hidden="true"
            />

            <div class="relative">
              <span class="text-4xl" aria-hidden="true">{evento.emoji}</span>

              <h3 class="mt-5 font-display text-2xl uppercase tracking-tight text-white">
                {evento.titulo}
              </h3>

              <p class="mt-3 text-sm leading-relaxed text-white/50">{evento.descripcion}</p>

              <ul class="mt-6 space-y-2.5 border-t border-white/8 pt-5">
                {evento.detalles.map((detalle) => (
                  <li class="flex items-start gap-2.5 text-sm text-white/65">
                    <span
                      class:list={["mt-[7px] h-1 w-1 shrink-0 rounded-full bg-current", TEXTO[evento.acento]]}
                      aria-hidden="true"
                    />
                    {detalle}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
