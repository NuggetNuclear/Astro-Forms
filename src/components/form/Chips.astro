---
import type { Acento } from "../../data/formulario";
import { ACENTO_ACTIVO, ACENTO_MARCA, FOCO_LABEL } from "./estilos";

interface Props {
  nombre: string;
  etiqueta: string;
  opciones: string[];
  ayuda?: string;
  acento?: Acento;
}

const { nombre, etiqueta, opciones, ayuda, acento = "cyan" } = Astro.props;
---

<fieldset>
  <legend class="text-[11px] font-semibold uppercase tracking-[0.14em] text-white/55">
    {etiqueta}
  </legend>
  {ayuda && <p class="mt-1.5 text-xs text-white/40">{ayuda}</p>}

  <div class="mt-3 flex flex-wrap gap-2">
    {opciones.map((opcion, i) => (
      <label
        class:list={[
          "flex cursor-pointer select-none items-center gap-2.5 rounded-full border border-white/12",
          "bg-white/[0.03] px-4 py-2 text-sm text-white/70",
          "transition-all duration-200 ease-out",
          "hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/[0.07] hover:text-white",
          "has-[:checked]:font-semibold",
          ACENTO_ACTIVO[acento],
          FOCO_LABEL,
        ]}
      >
        <input
          type="checkbox"
          id={`${nombre}-${i}`}
          name={nombre}
          value={opcion}
          class="peer sr-only"
        />
        <span
          class:list={[
            "grid h-4 w-4 shrink-0 place-items-center rounded-[6px] border border-white/25",
            "text-ink-950 transition-colors duration-200",
            ACENTO_MARCA[acento],
          ]}
          aria-hidden="true"
        >
          <svg
            class="h-2.5 w-2.5 scale-0 opacity-0 transition-all duration-200"
            viewBox="0 0 12 12" fill="none" stroke="currentColor"
            stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"
          >
            <path d="m2 6.4 2.6 2.6L10 3.4" />
          </svg>
        </span>
        <span>{opcion}</span>
      </label>
    ))}
  </div>
</fieldset>
