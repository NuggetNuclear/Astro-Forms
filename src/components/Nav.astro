---
import { MARCA, MENSAJE_WHATSAPP_DEFECTO, linkWhatsApp } from "../data/sitio";

const enlaces = [
  { href: "#servicios", texto: "Servicios" },
  { href: "#equipamiento", texto: "Equipamiento" },
  { href: "#proceso", texto: "Cómo trabajo" },
  { href: "#reserva", texto: "Reservar" },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-ink-950/80 backdrop-blur-xl transition-colors duration-300 data-[fijo]:border-white/10 data-[fijo]:bg-ink-950/95"
  data-nav
>
  <div class="mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between gap-6 px-5 sm:px-8">
    <a
      href="#inicio"
      class="group flex items-center gap-3 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan"
      aria-label={`${MARCA.nombre} — inicio`}
    >
      <span class="relative grid h-9 w-9 place-items-center" aria-hidden="true">
        <span
          class="absolute inset-0 rounded-full bg-gradient-to-br from-neon-cyan via-neon-magenta to-neon-yellow opacity-90 blur-[6px] transition-opacity duration-300 group-hover:opacity-100"
        ></span>
        <span class="relative grid h-9 w-9 place-items-center rounded-full border-2 border-white/80 bg-ink-950">
          <span class="h-2 w-2 rounded-full bg-white"></span>
        </span>
      </span>
      <span class="leading-none">
        <span class="block font-display text-lg uppercase tracking-wide text-white">Lookuman</span>
        <span class="block text-[10px] font-semibold uppercase tracking-[0.22em] text-neon-cyan">
          EnergyMan
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegación principal">
      {
        enlaces.map((enlace) => (
          <a
            href={enlace.href}
            class="rounded-full px-4 py-2 text-sm font-medium text-white/60 transition-colors duration-200 hover:bg-white/5 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan"
          >
            {enlace.texto}
          </a>
        ))
      }
    </nav>

    <a
      href={linkWhatsApp(MENSAJE_WHATSAPP_DEFECTO)}
      target="_blank"
      rel="noopener"
      class="group hidden items-center gap-2 rounded-full bg-gradient-to-r from-neon-cyan to-neon-cyan-soft px-5 py-2.5 text-sm font-bold text-ink-950 shadow-[0_0_24px_-6px_var(--color-neon-cyan)] transition-all duration-300 hover:scale-[1.04] hover:shadow-[0_0_36px_-4px_var(--color-neon-cyan)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-ink-950 sm:inline-flex"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.53.07-.8.38-.28.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.09 4.49.71.3 1.27.49 1.7.63.71.23 1.36.19 1.88.12.57-.09 1.76-.72 2-1.42.25-.7.25-1.29.18-1.42-.08-.13-.27-.2-.57-.35Z"
        ></path>
        <path
          d="M12.04 2C6.6 2 2.17 6.43 2.17 11.87c0 1.74.46 3.44 1.32 4.94L2 22l5.34-1.4a9.83 9.83 0 0 0 4.7 1.2h.01c5.43 0 9.86-4.43 9.86-9.87A9.8 9.8 0 0 0 12.04 2Zm0 18.06h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.1.81.83-3.02-.2-.31a8.15 8.15 0 0 1-1.25-4.35c0-4.52 3.68-8.2 8.2-8.2a8.2 8.2 0 0 1 8.2 8.2c0 4.52-3.68 8.19-8.2 8.19Z"
        ></path>
      </svg>
      Cotizar ahora
    </a>
  </div>
</header>

<script>
  /* El nav se opaca al hacer scroll: translúcido sobre el hero, sólido
     cuando hay contenido pasando por detrás. */
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const alternar = () => {
      if (window.scrollY > 24) nav.dataset.fijo = "";
      else delete nav.dataset.fijo;
    };
    alternar();
    window.addEventListener("scroll", alternar, { passive: true });
  }
</script>
