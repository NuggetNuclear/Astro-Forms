---
import { EQUIPAMIENTO } from "../data/sitio";

const TEXTO = {
  cyan: "text-neon-cyan",
  magenta: "text-neon-magenta",
  yellow: "text-neon-yellow",
} as const;

const BORDE = {
  cyan: "group-hover:border-neon-cyan/60 group-hover:shadow-[0_0_44px_-12px_var(--color-neon-cyan)]",
  magenta: "group-hover:border-neon-magenta/60 group-hover:shadow-[0_0_44px_-12px_var(--color-neon-magenta)]",
  yellow: "group-hover:border-neon-yellow/60 group-hover:shadow-[0_0_44px_-12px_var(--color-neon-yellow)]",
} as const;
---

<section id="equipamiento" class="relative scroll-mt-24 overflow-hidden py-24 sm:py-32">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="light-blob left-1/2 top-1/2 h-[34rem] w-[34rem] -translate-x-1/2 -translate-y-1/2 bg-neon-cyan/10"></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16">
      <!-- Texto -->
      <header data-reveal>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-neon-yellow/30 bg-neon-yellow/[0.07] px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-neon-yellow"
        >
          <span class="h-1.5 w-1.5 animate-pulse-glow rounded-full bg-neon-yellow"></span>
          Equipamiento incluido
        </span>

        <h2 class="mt-6 font-display text-4xl uppercase leading-[0.95] sm:text-5xl">
          Sonido que se <span class="text-gradient-cyan">siente</span>,<br />
          luces que se <span class="text-neon-magenta">ven</span>
        </h2>

        <p class="mt-5 max-w-lg text-base leading-relaxed text-white/55">
          El pack completo llega montado y probado antes de que aparezca el primer invitado. Sin
          costos ocultos ni sorpresas de última hora.
        </p>

        <dl class="mt-9 grid grid-cols-2 gap-5 border-t border-white/8 pt-8">
          <div>
            <dt class="text-[11px] font-bold uppercase tracking-[0.16em] text-white/40">Montaje</dt>
            <dd class="mt-1.5 font-display text-2xl uppercase text-white">Incluido</dd>
          </div>
          <div>
            <dt class="text-[11px] font-bold uppercase tracking-[0.16em] text-white/40">Cobertura</dt>
            <dd class="mt-1.5 font-display text-2xl uppercase text-white">Todo Chile</dd>
          </div>
        </dl>
      </header>

      <!-- Tarjetas -->
      <div class="grid gap-4 sm:grid-cols-2">
        {
          EQUIPAMIENTO.map((item, i) => (
            <article
              class="group relative rounded-3xl border border-white/8 bg-ink-900/50 p-7 transition-all duration-400 ease-out hover:-translate-y-1.5"
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
            >
              <div class="flex items-start gap-5">
                <span
                  class:list={[
                    "grid h-14 w-14 shrink-0 place-items-center rounded-2xl border border-white/12 bg-white/[0.03]",
                    "font-display text-2xl transition-all duration-400",
                    TEXTO[item.acento],
                    BORDE[item.acento],
                  ]}
                  aria-hidden="true"
                >
                  {item.cantidad}
                </span>

                <div class="min-w-0">
                  <h3 class="text-base font-bold leading-tight text-white">{item.titulo}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-white/50">{item.descripcion}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
