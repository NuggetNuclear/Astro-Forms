---
import { CAMPO_BASE, ETIQUETA_FLOTANTE, ETIQUETA_REPOSO, AYUDA } from "./estilos";

interface Props {
  nombre: string;
  etiqueta: string;
  tipo?: "text" | "email" | "tel" | "date" | "time" | "number";
  ayuda?: string;
  requerido?: boolean;
  autocomplete?: string;
  inputmode?: "text" | "tel" | "email" | "numeric";
  min?: string;
}

const {
  nombre,
  etiqueta,
  tipo = "text",
  ayuda,
  requerido = false,
  autocomplete,
  inputmode,
  min,
} = Astro.props;

/* date/time siempre muestran un formato de fondo, así que su etiqueta vive
   arriba de forma permanente: el truco del placeholder no aplica. */
const siempreArriba = tipo === "date" || tipo === "time";
const idAyuda = ayuda ? `${nombre}-ayuda` : undefined;
---

<div class="group relative">
  <div class="relative">
    <input
      type={tipo}
      id={nombre}
      name={nombre}
      placeholder=" "
      required={requerido}
      min={min}
      autocomplete={autocomplete}
      inputmode={inputmode}
      aria-describedby={idAyuda}
      class:list={[
        CAMPO_BASE,
        "px-5 pb-2.5 pt-7",
        siempreArriba && "[color-scheme:dark]",
      ]}
    />
    <label
      for={nombre}
      class:list={[ETIQUETA_FLOTANTE, !siempreArriba && ETIQUETA_REPOSO]}
    >
      {etiqueta}
      {requerido && <span class="ml-0.5 text-neon-magenta" aria-hidden="true">*</span>}
    </label>
  </div>
  {ayuda && <p id={idAyuda} class={AYUDA}>{ayuda}</p>}
</div>
