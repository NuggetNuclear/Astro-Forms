---
import { FACTORES_PRECIO, MENSAJE_WHATSAPP_DEFECTO, linkWhatsApp } from "../data/sitio";

const TEXTO = {
  cyan: "text-neon-cyan",
  magenta: "text-neon-magenta",
  yellow: "text-neon-yellow",
} as const;

const BORDE = {
  cyan: "hover:border-neon-cyan/45",
  magenta: "hover:border-neon-magenta/45",
  yellow: "hover:border-neon-yellow/45",
} as const;
---

<section id="precio" class="relative scroll-mt-24 py-24 sm:py-32">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="light-blob right-[-10%] top-16 h-[28rem] w-[28rem] bg-neon-yellow/10"></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <header class="mx-auto max-w-3xl text-center" data-reveal>
      <span
        class="inline-flex items-center gap-2 rounded-full border border-neon-yellow/30 bg-neon-yellow/[0.07] px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-neon-yellow"
      >
        <span class="h-1.5 w-1.5 animate-pulse-glow rounded-full bg-neon-yellow"></span>
        Precio
      </span>

      <h2 class="mt-6 font-display text-4xl uppercase leading-[0.95] sm:text-6xl">
        Qué define <span class="text-gradient-neon">el valor</span>
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-white/55 sm:text-lg">
        No hay tarifa fija, porque no hay dos fiestas iguales: cada evento se cotiza aparte. Estos
        son los cinco factores que definen el número, para que sepan de antemano qué les voy a
        preguntar y por qué.
      </p>
    </header>

    <ul class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        FACTORES_PRECIO.map((factor, i) => (
          <li
            class:list={[
              "group rounded-3xl border border-white/8 bg-ink-900/50 p-7",
              "transition-all duration-400 ease-out hover:-translate-y-1.5",
              BORDE[factor.acento],
            ]}
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <span class="text-3xl" aria-hidden="true">
              {factor.emoji}
            </span>

            <h3
              class:list={[
                "mt-5 font-display text-xl uppercase tracking-tight",
                TEXTO[factor.acento],
              ]}
            >
              {factor.titulo}
            </h3>

            <p class="mt-3 text-sm leading-relaxed text-white/50">{factor.descripcion}</p>
          </li>
        ))
      }

      <!-- Sexta celda: el llamado a la acción, en la grilla como una tarjeta más -->
      <li
        class="flex flex-col justify-between rounded-3xl border border-neon-cyan/25 bg-neon-cyan/[0.05] p-7"
        data-reveal
        style={`--reveal-delay:${FACTORES_PRECIO.length * 70}ms`}
      >
        <div>
          <h3 class="font-display text-xl uppercase tracking-tight text-white">
            Sin sorpresas después
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-white/55">
            El valor que les envío incluye equipo, traslado, montaje, prueba de sonido y toda la
            noche de música. Lo que no esté ahí, no se cobra al final.
          </p>
        </div>

        <div class="mt-7 flex flex-col gap-2.5">
          <a
            href="#reserva"
            class="rounded-full bg-gradient-to-r from-neon-cyan to-neon-cyan-soft px-6 py-3 text-center text-sm font-bold uppercase tracking-wider text-ink-950 shadow-[0_0_28px_-8px_var(--color-neon-cyan)] transition-all duration-300 hover:shadow-[0_0_44px_-6px_var(--color-neon-cyan)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-ink-950"
          >
            Pedir mi cotización
          </a>

          <a
            href={linkWhatsApp(MENSAJE_WHATSAPP_DEFECTO)}
            target="_blank"
            rel="noopener"
            class="rounded-full border border-white/15 px-6 py-3 text-center text-sm font-semibold text-white/70 transition-all duration-200 hover:border-white/40 hover:bg-white/5 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan"
          >
            Preguntar por WhatsApp
          </a>
        </div>
      </li>
    </ul>
  </div>
</section>
