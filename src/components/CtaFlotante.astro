---
import { CONTACTO, MENSAJE_WHATSAPP_DEFECTO, linkWhatsApp } from "../data/sitio";
---

<!--
  CTA fijo. En móvil ocupa el ancho completo abajo (donde vive el pulgar);
  en escritorio se reduce a un botón flotante de WhatsApp.
-->
<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-4 opacity-0 transition-all duration-500 ease-out data-[visible]:translate-y-0 data-[visible]:opacity-100 sm:inset-x-auto sm:bottom-7 sm:right-7"
  data-cta-flotante
>
  <!-- Móvil -->
  <div
    class="pointer-events-auto flex items-center gap-3 border-t border-white/10 bg-ink-950/90 p-3.5 backdrop-blur-xl sm:hidden"
  >
    <a
      href={linkWhatsApp(MENSAJE_WHATSAPP_DEFECTO)}
      target="_blank"
      rel="noopener"
      class="grid h-12 w-12 shrink-0 place-items-center rounded-full border border-neon-cyan/40 bg-neon-cyan/10 text-neon-cyan transition-colors duration-200 active:bg-neon-cyan/20"
      aria-label={`Escribir por WhatsApp al ${CONTACTO.whatsappVisible}`}
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12.04 2C6.6 2 2.17 6.43 2.17 11.87c0 1.74.46 3.44 1.32 4.94L2 22l5.34-1.4a9.83 9.83 0 0 0 4.7 1.2h.01c5.43 0 9.86-4.43 9.86-9.87A9.8 9.8 0 0 0 12.04 2Zm5.43 12.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.53.07-.8.38-.28.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.09 4.49.71.3 1.27.49 1.7.63.71.23 1.36.19 1.88.12.57-.09 1.76-.72 2-1.42.25-.7.25-1.29.18-1.42-.08-.13-.27-.2-.57-.35Z"
        ></path>
      </svg>
    </a>

    <a
      href="#reserva"
      class="flex-1 rounded-full bg-gradient-to-r from-neon-magenta to-neon-yellow px-6 py-3.5 text-center text-sm font-bold uppercase tracking-wider text-ink-950 shadow-[0_0_30px_-8px_var(--color-neon-magenta)]"
    >
      Reservar mi fecha
    </a>
  </div>

  <!-- Escritorio -->
  <a
    href={linkWhatsApp(MENSAJE_WHATSAPP_DEFECTO)}
    target="_blank"
    rel="noopener"
    class="group pointer-events-auto hidden items-center gap-3 rounded-full bg-gradient-to-r from-neon-cyan to-neon-cyan-soft py-4 pl-4 pr-6 font-bold text-ink-950 shadow-[0_0_44px_-10px_var(--color-neon-cyan)] transition-all duration-300 hover:scale-[1.04] hover:shadow-[0_0_64px_-8px_var(--color-neon-cyan)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-ink-950 sm:flex"
  >
    <span class="relative grid h-9 w-9 place-items-center rounded-full bg-ink-950/15" aria-hidden="true">
      <span class="absolute inset-0 animate-ping rounded-full bg-ink-950/10"></span>
      <svg class="relative h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M12.04 2C6.6 2 2.17 6.43 2.17 11.87c0 1.74.46 3.44 1.32 4.94L2 22l5.34-1.4a9.83 9.83 0 0 0 4.7 1.2h.01c5.43 0 9.86-4.43 9.86-9.87A9.8 9.8 0 0 0 12.04 2Zm5.43 12.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.53.07-.8.38-.28.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.09 4.49.71.3 1.27.49 1.7.63.71.23 1.36.19 1.88.12.57-.09 1.76-.72 2-1.42.25-.7.25-1.29.18-1.42-.08-.13-.27-.2-.57-.35Z"
        ></path>
      </svg>
    </span>

    <span class="text-left leading-tight">
      <span class="block text-[10px] font-bold uppercase tracking-[0.16em] opacity-70">
        Respuesta rápida
      </span>
      <span class="block text-sm">{CONTACTO.whatsappVisible}</span>
    </span>
  </a>
</div>

<script>
  /* Aparece pasada la primera pantalla y se aparta mientras se llena el
     formulario, para no tapar los campos ni competir con "Enviar". */
  const cta = document.querySelector<HTMLElement>("[data-cta-flotante]");
  const reserva = document.querySelector<HTMLElement>("#reserva");

  if (cta) {
    let enFormulario = false;

    if (reserva) {
      new IntersectionObserver(
        ([entrada]) => {
          enFormulario = Boolean(entrada?.isIntersecting);
          actualizar();
        },
        { threshold: 0.12 },
      ).observe(reserva);
    }

    function actualizar() {
      const pasadoElHero = window.scrollY > window.innerHeight * 0.6;
      if (pasadoElHero && !enFormulario) cta!.dataset.visible = "";
      else delete cta!.dataset.visible;
    }

    actualizar();
    window.addEventListener("scroll", actualizar, { passive: true });
  }
</script>
